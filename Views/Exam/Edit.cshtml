@model OnlineSinavSistemi.Models.Exam

@{
    ViewData["Title"] = "Sınav Düzenle";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>@ViewData["Title"]</h2>
    </div>

    <div id="ajaxAlertContainer"></div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <form asp-action="Edit" method="post" id="editForm">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="TeacherId" />

        <div class="card shadow-sm">
            <div class="card-body">

                <div class="form-group">
                    <label asp-for="Title" class="control-label font-weight-bold">Sınav Başlığı</label>
                    <input asp-for="Title" class="form-control" placeholder="Örn: Matematik Vize Sınavı" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="form-row">
                    <div class="form-group col-md-6">
                        <label asp-for="CourseId" class="control-label font-weight-bold">Ders</label>
                        <select asp-for="CourseId" class="form-control" asp-items="ViewBag.Dersler">
                            <option value="">-- Ders Seçin --</option>
                        </select>
                        <span asp-validation-for="CourseId" class="text-danger"></span>
                    </div>

                    <div class="form-group col-md-6">
                        <label asp-for="DurationMinutes" class="control-label font-weight-bold">Sınav Süresi (Dakika)</label>
                        <input asp-for="DurationMinutes" class="form-control" type="number" min="1" max="480" />
                        <span asp-validation-for="DurationMinutes" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="StartDate" class="control-label font-weight-bold">Başlangıç Tarihi ve Saati</label>
                    <input asp-for="StartDate"
                           class="form-control"
                           type="datetime-local"
                           asp-format="{0:yyyy-MM-ddTHH:mm}" />
                    <span asp-validation-for="StartDate" class="text-danger"></span>
                    <small class="text-muted">Sınavın başlayacağı tarih ve saati seçiniz.</small>
                </div>

            </div>
            <div class="card-footer bg-white">
                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Listeye Dön
                    </a>

                    <div>
                        <button type="submit" class="btn btn-primary mr-2" id="saveBtn">
                            <i class="fas fa-save"></i> Kaydet ve Çık
                        </button>

                        <button type="button" class="btn btn-success" id="saveAndStayBtn">
                            <i class="fas fa-check-circle"></i> Kaydet ve Burada Kal
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function() {

            // --- AJAX ile Kaydetme İşlemi ---
            $('#saveAndStayBtn').click(function(e) {
                e.preventDefault();

                var form = $('#editForm');
                var btn = $(this);

                // 1. İstemci tarafı validasyon kontrolü (jQuery Validate)
                if (!form.valid()) {
                    return false; // Form geçerli değilse durdur
                }

                // Butonu devre dışı bırak (çift tıklamayı önle)
                var originalContent = btn.html();
                btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Kaydediliyor...');

                // Form verilerini al
                var formData = new FormData(form[0]);

                $.ajax({
                    url: '@Url.Action("Edit")',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    headers: {
                        "X-Requested-With": "XMLHttpRequest"
                    },
                    success: function(response) {
                        if (response.success) {
                            // Başarılı Alert
                            var alertHtml = `
                                <div class="alert alert-success alert-dismissible fade show" role="alert">
                                    <i class="fas fa-check-circle me-2"></i> ${response.message}
                                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                        <span aria-hidden="true">&times;</span>
                                    </button>
                                </div>`;

                            $('#ajaxAlertContainer').html(alertHtml).hide().fadeIn();

                            // 4 saniye sonra alerti kapat
                            setTimeout(function() {
                                $('.alert').fadeOut('slow', function(){ $(this).remove(); });
                            }, 4000);

                        } else {
                            // Backend Validasyon Hatası (JSON döndüyse)
                            var errorHtml = `
                                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                    <i class="fas fa-exclamation-triangle me-2"></i> ${response.message}
                                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                        <span aria-hidden="true">&times;</span>
                                    </button>
                                </div>`;
                            $('#ajaxAlertContainer').html(errorHtml);
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error(xhr);
                        var msg = "Bir hata oluştu.";
                        if(xhr.status === 400 || xhr.status === 500){
                            msg = "Sunucu hatası: Lütfen girdiğiniz verileri kontrol edin.";
                        }
                        alert(msg + " Detay: " + error);
                    },
                    complete: function() {
                        // Butonu eski haline getir
                        btn.prop('disabled', false).html(originalContent);
                    }
                });
            });
        });
    </script>

    <style>
        .form-control:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
        }
        /* Kart görünümü ekleyerek formu daha derli toplu yaptık */
        .card {
            border: none;
            border-radius: 10px;
        }
    </style>
}